spawn-at-startup "env" "NOCTALIA_CONFIG_HOME=/etc" "noctalia"

binds {
    Mod+Return { spawn "foot"; }
    Mod+D repeat=false hotkey-overlay-title="Open the application launcher" { spawn "noctalia" "msg" "panel-toggle" "launcher"; }
    Mod+Alt+L { spawn "noctalia" "msg" "session" "lock"; }
    Mod+Q { close-window; }
    Mod+Left { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Shift+E { quit; }

    XF86AudioRaiseVolume allow-when-locked=true { spawn "noctalia" "msg" "volume-up"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "noctalia" "msg" "volume-down"; }
    XF86AudioMute repeat=false allow-when-locked=true { spawn "noctalia" "msg" "volume-mute"; }
    XF86AudioMicMute repeat=false allow-when-locked=true { spawn "noctalia" "msg" "mic-mute"; }
}
